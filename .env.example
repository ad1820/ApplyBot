# === Supabase ===
# Just the project base URL - e.g. https://xxxxx.supabase.co
# Do NOT include a trailing slash or a path like /rest/v1 (the client adds
# that itself); doing so causes a PGRST125 "Invalid path" error.
SUPABASE_URL=
SUPABASE_KEY=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === LLM Provider Chains ===
#
# Two independent provider chains are built from the credentials below:
#
#   Agent reasoning / tool calling:
#     NVIDIA NIM (Muse Glimmer 30B) → Gemini primary → Gemini fallback → Groq → Null
#
#   Job search / skill matching:
#     Gemini primary → Gemini fallback → NVIDIA NIM → Groq → Null (deterministic always runs first)
#
# All providers are optional. The system starts cleanly with no keys — it
# falls back to deterministic-only matching (fully functional without any LLM).
# Configure only the providers you have access to; unused providers are skipped.
#
# Failover is automatic for transient errors (429, 5xx, timeouts).
# Non-retryable errors (invalid API key, bad request) are logged clearly and
# do not trigger failover — the job discovery pipeline continues unaffected.

# --- Google Gemini ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- NVIDIA NIM ---
# https://build.nvidia.com  (has a free tier)
# Primary reasoning/tool-calling model: meta/muse-glimmer-30b (30B, strong)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/muse-glimmer-30b

# --- Groq Cloud ---
# https://console.groq.com  (generous free tier)
# Comma-separated list of models. Multiple models bypass the 1k req/day
# limit by falling back across them when a rate limit is hit.
# Recommended large (>15B) models:
#   openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b
GROQ_API_KEY=
GROQ_MODELS=

# === Google Sheets ===
# Local development: path to a service account JSON key file on disk.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Production fallback: paste the same JSON key's raw content here instead
# (used only if the file above is not found, e.g. on a hosting platform
# where you store secrets as environment variables).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# === App ===
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
JOB_SEARCH_SCHEDULE=08:00

# Shared secret required on the scheduled trigger endpoint so it cannot be
# invoked by anyone who merely knows the URL (e.g. Supabase Cron -> HTTP call).
SCHEDULER_SECRET=

# Minimum match score (0-100) required before a job is pushed as a Telegram
# notification. Jobs below this are still saved and visible via /jobs.
MINIMUM_MATCH_SCORE=82

# === Candidate config (production fallback) ===
# Local development: config/candidate_profile.json, config/job_preferences.json,
# and config/candidate_skills.json are used directly (git-ignored real files -
# copy the matching *.example.json templates to get started).
# Production: paste the same JSON content into these instead - whichever
# source (file or env var) is present is used automatically.
CANDIDATE_PROFILE_JSON=
JOB_PREFERENCES_JSON=
CANDIDATE_SKILLS_JSON=
