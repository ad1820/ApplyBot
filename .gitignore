# Google service account key files (any name) - never commit real
# credentials. In production, paste the same JSON content into the
# GOOGLE_SERVICE_ACCOUNT_JSON secret environment variable instead.
google_service_account.json
*service-account*.json
*service_account*.json

# Real candidate config - contains PII and/or personal preferences.
# Tracked *.example.json templates show the expected shape instead. In
# production, paste the same JSON content into the matching *_JSON secret
# environment variable (CANDIDATE_PROFILE_JSON, JOB_PREFERENCES_JSON,
# CANDIDATE_SKILLS_JSON) instead of committing these files.
config/candidate_profile.json
config/job_preferences.json
config/candidate_skills.json
